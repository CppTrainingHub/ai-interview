# AI Interview local configuration example.
# Copy this file to config/app.local.env, then replace the Chinese placeholders.

AI_INTERVIEW_LLM_API_URL=填写你的大模型接口地址
AI_INTERVIEW_LLM_API_KEY=填写你的API密钥
AI_INTERVIEW_LLM_MODEL=填写你的模型名称
AI_INTERVIEW_LLM_TEMPERATURE=0.2
AI_INTERVIEW_LLM_MAX_TOKENS=2048
AI_INTERVIEW_LLM_TIMEOUT_SECONDS=60
AI_INTERVIEW_REPORT_DIR=reports

# Runtime mode.
# text: read answers from CLI or HTTP JSON.
# audio: use AudioDevice + ASR + TTS through SpeechPipeline.
AI_INTERVIEW_RUNTIME_MODE=text

# Dependency mode.
# openai: use AI_INTERVIEW_LLM_* service config.
# scripted: run a complete offline interview without external LLM service.
AI_INTERVIEW_DEPENDENCY_MODE=openai

# Optional offline/audio settings.
AI_INTERVIEW_AUDIO_DEVICE=null
AI_INTERVIEW_ASR_PROVIDER=scripted
AI_INTERVIEW_TTS_PROVIDER=silent_pcm
AI_INTERVIEW_INPUT_WAV_PATH=
AI_INTERVIEW_OUTPUT_WAV_PATH=reports/audio_output.wav
AI_INTERVIEW_SCRIPTED_TRANSCRIPTS=I am ready.||RAII uses destructors.||vector may reallocate.

# HTTP server defaults.
AI_INTERVIEW_HTTP_HOST=127.0.0.1
AI_INTERVIEW_HTTP_PORT=8080

# Optional realtime ASR/TTS configuration.
# Enable at build time with -DAI_INTERVIEW_ENABLE_VOLCENGINE_REALTIME=ON.
AI_INTERVIEW_SPEECH_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
AI_INTERVIEW_SPEECH_APP_ID=填写你的火山引擎应用ID
AI_INTERVIEW_SPEECH_ACCESS_KEY=填写你的火山引擎访问密钥
AI_INTERVIEW_SPEECH_APP_KEY=填写你的火山引擎应用密钥
AI_INTERVIEW_SPEECH_RESOURCE_ID=volc.speech.dialog
AI_INTERVIEW_SPEECH_SPEAKER=zh_male_yunzhou_jupiter_bigtts
